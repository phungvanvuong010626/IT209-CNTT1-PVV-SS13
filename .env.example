# Mẫu cấu hình môi trường. Sao chép thành .env và đổi các giá trị bí mật:
#   cp .env.example .env
# Tệp .env KHÔNG được commit lên Git.

# Tên cơ sở dữ liệu MySQL.
DB_NAME=campus_hub

# Tài khoản ứng dụng dùng để kết nối MySQL.
DB_USER=campus
DB_PASSWORD=change_me

# Mật khẩu root của MySQL (chỉ dùng khi khởi tạo container).
DB_ROOT_PASSWORD=change_me_root

# Danh sách nguồn (origin) được phép gọi API, phân tách bằng dấu phẩy.
CORS_ALLOWED_ORIGINS=http://161.118.239.231

# Cổng công khai của dịch vụ web trên máy chủ.
WEB_PORT=80

# Số báo cáo đang chờ để bài đăng tự chuyển sang trạng thái "đang kiểm duyệt".
MODERATION_AUTO_REVIEW_THRESHOLD=3
